# Keep the repository limited to build inputs and shared development files.
# A new source or support file type needs an explicit exception here.
*
!/.gitignore
!/LICENSE
!/README.md
!/AGENTS.md
!/GLOSSARY.md
!/OshiTuner.sln
!/skills-lock.json

# WPF project
!/src/
!/src/oshituner/
!/src/oshituner/**/
!/src/oshituner/oshituner.csproj
!/src/oshituner/Version.props
!/src/oshituner/BuildVersion.targets
!/src/oshituner/app.manifest
!/scripts/
!/scripts/Set-OfficialVersion.ps1
!/scripts/Build-WindowsInstaller.ps1
!/scripts/Guard-BrowserHost.ps1
!/installer/
!/installer/OshiTuner.iss
!/browser/
!/browser/edge/
!/browser/chrome/
!/browser/edge/manifest.json
!/browser/chrome/manifest.json
!/browser/worker.js
!/browser/player-recovery.js
!/static/
!/static/images/
!/static/images/vtuber-viewer-background-4k-v2.png
!/src/oshituner/ThirdParty/SkiaSharp-*.txt
!/docs/browser-integration.md
!/src/oshituner/**/*.cs
!/src/oshituner/**/*.xaml
!/src/oshituner/ThirdParty/ModelContextProtocol-*.txt

# Shared skills and supporting documentation
!/.agents/
!/.agents/skills/
!/.agents/skills/**/
!/.agents/skills/**/*.md
!/.agents/skills/**/*.yaml
!/.agents/skills/**/*.sh
!/.agents/skills/**/*.cjs
!/.agents/skills/graphify/.graphify_version
!/.github/
!/.github/workflows/
!/.github/workflows/build.yml
!/.github/workflows/release.yml
!/.github/skills/
!/.github/skills/twitch-api/
!/.github/skills/twitch-api/SKILL.md
!/docs/
!/docs/twitch-api.md
!/docs/agents/
!/docs/agents/*.md
!/docs/adr/
!/docs/adr/*.md

# Generated and local files inside shared trees
**/[Bb]in/
**/[Oo]bj/
**/.vs/
**/.vscode/
**/.codex/
**/node_modules/
**/TestResults/
**/.env
**/.env.*
/graphify-out/
/src/oshituner/.build/

# Local plans and implementation tasks
/.plans/
