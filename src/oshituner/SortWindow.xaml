<Window x:Class="oshituner.SortWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Channel sort" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBackground}">
    <StackPanel Margin="20">
        <TextBlock Margin="0,0,0,8" Text="Group order" FontWeight="Bold" />
        <ListBox x:Name="Groups" Height="118" DisplayMemberPath="Title" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,16">
            <Button Click="Up_Click" Margin="0,0,6,0">Move up</Button>
            <Button Click="Down_Click">Move down</Button>
        </StackPanel>
        <TextBlock Margin="0,0,0,6" Text="Within each group" FontWeight="Bold" />
        <ComboBox x:Name="Secondary" DisplayMemberPath="Title" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Click="Reset_Click" Margin="0,0,6,0">Reset</Button>
            <Button IsCancel="True" Margin="0,0,6,0">Cancel</Button>
            <Button Click="Save_Click" IsDefault="True">Apply</Button>
        </StackPanel>
    </StackPanel>
</Window>
