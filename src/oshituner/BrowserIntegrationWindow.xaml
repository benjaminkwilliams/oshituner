<Window x:Class="oshituner.BrowserIntegrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browser Integration" Width="620" MinWidth="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}" FontFamily="{DynamicResource ApplicationFont}">
    <StackPanel Margin="20">
        <TextBlock Text="Each browser can pair with one installation of Oshi Tuner." TextWrapping="Wrap" Margin="0,0,0,12" />
        <ItemsControl x:Name="BrowserList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" />
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4,0,8" />
                        <WrapPanel>
                            <Button Content="{Binding PairLabel}" Tag="{Binding Browser}" IsEnabled="{Binding CanPair}" Click="Pair_Click" />
                            <Button Content="Unpair" Margin="8,0,0,0" Tag="{Binding Browser}" IsEnabled="{Binding CanUnpair}" Click="Unpair_Click" />
                        </WrapPanel>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,0,0,8" />
        <Button Content="Setup instructions" Click="Instructions_Click" HorizontalAlignment="Left" />
    </StackPanel>
</Window>
