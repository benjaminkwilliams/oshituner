<UserControl x:Class="oshituner.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock x:Name="LogPath" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}" />
            <Button Content="Copy log" Click="CopyLog_Click" HorizontalAlignment="Left" Margin="0,6,0,0" />
        </StackPanel>
        <ListBox x:Name="LogEntries" DisplayMemberPath="Text" AutomationProperties.Name="Application log"
                 FontFamily="Consolas" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
    </DockPanel>
</UserControl>
