<UserControl x:Class="oshituner.TwitchStatusView"
             Foreground="{DynamicResource PrimaryForeground}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <Style x:Key="BrowserWatchButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Padding" Value="1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                <Button x:Name="ConnectButton" Content="Connect Twitch" Click="ConnectButton_Click" Margin="0,0,6,0" />
                <Button x:Name="DisconnectButton" Content="Disconnect" Click="DisconnectButton_Click" Margin="0,0,6,0" Visibility="Collapsed" />
                <Button x:Name="CancelConnectButton" Content="Cancel" Click="CancelAuthorizationButton_Click" Margin="0,0,6,0" Visibility="Collapsed" />
                <Border Background="{DynamicResource PanelBackground}" CornerRadius="16" Padding="13,7">
                    <TextBlock x:Name="ConnectionStatusText" Text="Not connected" />
                </Border>
            </StackPanel>
        </Grid>

        <Border x:Name="AuthorizationPanel" Grid.Row="1" Background="{DynamicResource PanelBackground}" CornerRadius="8" Padding="16" Margin="0,0,0,14" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Finish signing in to Twitch" FontWeight="SemiBold" />
                    <TextBlock x:Name="AuthorizationCodeText" Text="Waiting for Twitch..." FontSize="20" FontWeight="Bold" Margin="0,5,0,0" />
                    <TextBlock Text="Open the activation page and enter this code. You only need to approve access once."
                               Foreground="{DynamicResource MutedForeground}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Button x:Name="OpenActivationButton" Grid.Column="1" Content="Open Twitch" Click="OpenActivationButton_Click" VerticalAlignment="Center" Margin="0,0,8,0" IsEnabled="False" />
                <Button Grid.Column="2" Content="Cancel" Click="CancelAuthorizationButton_Click" VerticalAlignment="Center" Background="{DynamicResource DockHeaderBackground}" Foreground="{DynamicResource PrimaryForeground}" />
            </Grid>
        </Border>

        <WrapPanel Grid.Row="2" Margin="0,0,0,8" x:Name="ListToolbar" Visibility="Collapsed">
            <Border Background="{DynamicResource PanelBackground}" Padding="6,0" Margin="0,4,12,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="FollowCountText" Text="0 followed" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="  ·  " Foreground="{DynamicResource MutedForeground}" />
                    <TextBlock x:Name="LiveCountText" Text="0 live" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <WrapPanel Orientation="Horizontal">
                <Button Content="Sort…" Click="EditSort_Click" Margin="0,0,6,0" />
                <Button x:Name="RefreshButton" Content="Refresh ▾" Click="OpenRefreshMenu_Click"
                        AutomationProperties.Name="Refresh" Margin="0,0,6,0">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="RefreshMenu" Placement="Bottom">
                            <MenuItem x:Name="RefreshNow" Header="Now" Click="RefreshNow_Click" />
                            <Separator />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </WrapPanel>
        </WrapPanel>

        <WrapPanel x:Name="ColumnEditor" Grid.Row="3" Visibility="Collapsed" Margin="0,0,0,8">
            <Label x:Name="ColumnEditorLabel" Target="{Binding ElementName=ColumnQuery}" />
            <TextBox x:Name="ColumnQuery" Width="200" KeyDown="ColumnQuery_KeyDown" />
            <Button x:Name="ColumnApply" Click="ColumnApply_Click" Margin="6,0,0,0" />
            <Button Content="Close" Click="CloseColumnEditor_Click" Margin="6,0,0,0" />
            <TextBlock x:Name="ColumnFeedback" Margin="8,0,0,0" AutomationProperties.LiveSetting="Polite" />
        </WrapPanel>

        <Border Grid.Row="4" CornerRadius="8">
            <Grid>
                <DataGrid x:Name="FollowedChannelsGrid" ItemsSource="{Binding FollowedChannels}" AlternationCount="2" CanUserSortColumns="False"
                          PreviewMouseRightButtonDown="SelectChannelForContextMenu">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <EventSetter Event="Loaded" Handler="ColumnHeader_Loaded" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.ContextMenu>
                        <ContextMenu Opened="ChannelMenu_Opened">
                            <MenuItem Header="Copy Twitch login" Click="CopyLogin_Click" />
                            <MenuItem x:Name="AddOshiMenu" Header="Add to Oshi" />
                            <MenuItem x:Name="ManageStreamMenu" Header="Manage open stream">
                                <MenuItem Header="Microsoft Edge" Tag="edge" Click="ManageStream_Click" />
                                <MenuItem Header="Google Chrome" Tag="chrome" Click="ManageStream_Click" />
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="RANK" Binding="{Binding RankName}" SortMemberPath="RankOrder" Width="145">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding RankName}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="STATUS" SortMemberPath="Status" Width="92">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status}" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource MutedForeground}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource LiveBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="WATCH" SortMemberPath="WatchStatus" Width="112">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding WatchStatus}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource WatchBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Watching}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource WatchingBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding CanOpenWatch, Converter={StaticResource VisibleWhenTrue}}">
                                            <Button Style="{StaticResource BrowserWatchButton}" Tag="edge" Click="WatchBrowser_Click"
                                                    Visibility="{Binding EdgeAvailable, Converter={StaticResource VisibleWhenTrue}}"
                                                    ToolTip="Watch in Microsoft Edge" AutomationProperties.Name="Watch in Microsoft Edge">
                                                <Path Width="13" Height="13" Stretch="Uniform"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}"
                                                      Data="M1,9 C1,4 5,1 9,1 C13,1 15,4 15,8 L4,8 C4,12 9,14 13,11 L13,14 C7,17 1,14 1,9 Z M5,6 L12,6 C11,2 7,3 5,6 Z" />
                                            </Button>
                                            <Button Style="{StaticResource BrowserWatchButton}" Tag="chrome" Click="WatchBrowser_Click"
                                                    Visibility="{Binding ChromeAvailable, Converter={StaticResource VisibleWhenTrue}}"
                                                    ToolTip="Watch in Google Chrome" AutomationProperties.Name="Watch in Google Chrome">
                                                <Path Width="13" Height="13" Stretch="Uniform" StrokeThickness="1.8"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}"
                                                      Data="M22,12 A10,10 0 1 1 2,12 A10,10 0 1 1 22,12 Z
                                                            M16,12 A4,4 0 1 1 8,12 A4,4 0 1 1 16,12 Z
                                                            M5,5 L8.5,10 M12,8 L21,8 M15.5,14 L11,22" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="SUB" SortMemberPath="SubscriptionStatus" Binding="{Binding SubscriptionStatus}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource MutedForeground}" />
                                    <Setter Property="ToolTip" Value="{Binding SubscriptionDetail}" />
                                    <Setter Property="AutomationProperties.HelpText" Value="{Binding SubscriptionDetail}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Subbed}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SubBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="CHANNEL" SortMemberPath="DisplayName" Binding="{Binding DisplayName}" Width="170">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding Login}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="CATEGORY" SortMemberPath="GameName" Binding="{Binding GameName}" Width="170" />
                        <DataGridTextColumn Header="STREAM TITLE" SortMemberPath="StreamTitle" Binding="{Binding StreamTitle}" Width="*" />
                        <DataGridTextColumn Header="VIEWERS" SortMemberPath="ViewerCount" Binding="{Binding ViewerCount, StringFormat=N0}" Width="90" />
                        <DataGridTextColumn Header="FOLLOWED" SortMemberPath="FollowedAt" Binding="{Binding FollowedAt, StringFormat={}{0:yyyy-MM-dd}}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
                <Border x:Name="EmptyStatePanel" Background="{DynamicResource PanelBackground}" Padding="12"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Connect Twitch to see followed channels and gifted subs"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Live channels will be marked LIVE; offline channels stay in the list."
                                   Foreground="{DynamicResource MutedForeground}"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
