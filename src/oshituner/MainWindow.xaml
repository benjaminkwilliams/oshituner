<Window x:Class="oshituner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Oshi Tuner"
        Width="1180"
        Height="760"
        MinWidth="860"
        MinHeight="560"
        Background="{DynamicResource WindowBackground}" FontFamily="{DynamicResource ApplicationFont}"
        Foreground="{DynamicResource PrimaryForeground}"
        Loaded="Window_Loaded">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Settings">
                <MenuItem Header="_Theme" Click="Theme_Click" />
                <MenuItem Header="_Browser Integration" Click="BrowserIntegration_Click" />
                <MenuItem Header="_Auto Launch" SubmenuOpened="AutoLaunch_Opened">
                    <MenuItem x:Name="AutoLaunchEnabled" Header="_Enabled" IsCheckable="True" Click="AutoLaunchEnabled_Click" />
                    <MenuItem x:Name="AutoLaunchCooldown" Header="_Cooldown" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Windows">
                <MenuItem Header="_Twitch Status" Click="ShowTwitchStatus_Click" />
                <MenuItem Header="_Oshi" Click="ShowOshi_Click" />
                <MenuItem Header="_Log" Click="ShowLog_Click" />
            </MenuItem>
            <MenuItem Header="_Plugins">
                <MenuItem Header="_Twitch">
                    <MenuItem Header="_Client ID" Click="ClientId_Click" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="About_Click" />
                <MenuItem Header="Copy _Codex configuration" Click="CopyCodexConfiguration_Click" />
            </MenuItem>
        </Menu>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ContentControl x:Name="WorkspaceHost" Grid.Row="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

        <StackPanel Grid.Row="1">
        <Border x:Name="MessagePanel" Visibility="Collapsed" Background="{DynamicResource PanelBackground}" Margin="0,8,0,0" Padding="8,4">
            <StackPanel x:Name="MessageEntries" />
        </Border>
        <TextBlock x:Name="ControlStatus" Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
    </DockPanel>
</Window>
