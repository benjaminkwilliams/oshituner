<Window x:Class="oshituner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Oshi Tuner"
        Width="1180"
        Height="760"
        MinWidth="860"
        MinHeight="560"
        Background="{DynamicResource WindowBackground}" FontFamily="{DynamicResource ApplicationFont}"
        Foreground="{DynamicResource PrimaryForeground}"
        Loaded="Window_Loaded">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Settings">
                <MenuItem Header="_Theme" Click="Theme_Click" />
                <MenuItem Header="_Browser Integration" Click="BrowserIntegration_Click" />
                <MenuItem Header="_Auto Launch" SubmenuOpened="AutoLaunch_Opened">
                    <MenuItem x:Name="AutoLaunchEnabled" Header="_Enabled" IsCheckable="True" Click="AutoLaunchEnabled_Click" />
                    <MenuItem x:Name="AutoLaunchCooldown" Header="_Cooldown" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Windows">
                <MenuItem Header="_Twitch Status" Click="ShowTwitchStatus_Click" />
                <MenuItem Header="_Oshi" Click="ShowOshi_Click" />
            </MenuItem>
            <MenuItem Header="_Plugins">
                <MenuItem Header="_Twitch">
                    <MenuItem Header="_Client ID" Click="ClientId_Click" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="About_Click" />
                <MenuItem Header="Copy _Codex configuration" Click="CopyCodexConfiguration_Click" />
            </MenuItem>
        </Menu>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                <Button x:Name="ConnectButton" Content="Connect Twitch" Click="ConnectButton_Click" Margin="0,0,6,0" />
                <Button x:Name="DisconnectButton" Content="Disconnect" Click="DisconnectButton_Click" Margin="0,0,6,0" Visibility="Collapsed" />
                <Button x:Name="CancelConnectButton" Content="Cancel" Click="CancelAuthorizationButton_Click" Margin="0,0,6,0" Visibility="Collapsed" />
                <Border Background="{DynamicResource PanelBackground}" CornerRadius="16" Padding="13,7">
                    <TextBlock x:Name="ConnectionStatusText" Text="Not connected" />
                </Border>
            </StackPanel>
        </Grid>

        <Border x:Name="AuthorizationPanel" Grid.Row="1" Background="{DynamicResource PanelBackground}" CornerRadius="8" Padding="16" Margin="0,0,0,14" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Finish signing in to Twitch" FontWeight="SemiBold" />
                    <TextBlock x:Name="AuthorizationCodeText" Text="Waiting for Twitch..." FontSize="20" FontWeight="Bold" Margin="0,5,0,0" />
                    <TextBlock Text="Open the activation page and enter this code. You only need to approve access once."
                               Foreground="{DynamicResource MutedForeground}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Button x:Name="OpenActivationButton" Grid.Column="1" Content="Open Twitch" Click="OpenActivationButton_Click" VerticalAlignment="Center" Margin="0,0,8,0" IsEnabled="False" />
                <Button Grid.Column="2" Content="Cancel" Click="CancelAuthorizationButton_Click" VerticalAlignment="Center" Background="{DynamicResource DockHeaderBackground}" Foreground="{DynamicResource PrimaryForeground}" />
            </Grid>
        </Border>

        <ContentControl x:Name="WorkspaceHost" Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

        <StackPanel Grid.Row="3">
        <TextBlock x:Name="MessageText"
                   Text="Set your Twitch Client ID under Plugins > Twitch > Client ID."
                   Foreground="{DynamicResource MutedForeground}"
                   TextWrapping="Wrap"
                   Margin="2,14,2,0" />
        <TextBlock x:Name="ControlStatus" Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
    </DockPanel>
</Window>
