<UserControl x:Class="oshituner.OshiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <WrapPanel Margin="0,0,0,8">
                <Button x:Name="RunningButton" Click="Running_Click" Margin="0,0,8,0" />
                <TextBlock x:Name="BrowserStatus" TextWrapping="Wrap" />
            </WrapPanel>
            <WrapPanel Margin="0,0,0,8">
                <Label Content="Default browser" Target="{Binding ElementName=DefaultBrowser}" />
                <ComboBox x:Name="DefaultBrowser" SelectedValuePath="Tag" Width="95">
                    <ComboBoxItem Content="Edge" Tag="edge" />
                    <ComboBoxItem Content="Chrome" Tag="chrome" />
                </ComboBox>
                <Label Content="Edge tabs" Target="{Binding ElementName=EdgeCap}" />
                <TextBox x:Name="EdgeCap" Width="50" />
                <Label Content="Chrome tabs" Target="{Binding ElementName=ChromeCap}" />
                <TextBox x:Name="ChromeCap" Width="50" />
                <Button Margin="8,0,0,0" Content="Apply" Click="Apply_Click" />
            </WrapPanel>
        </StackPanel>
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button Content="Rank up" Click="MoveRank_Click" Tag="-1" Margin="0,0,5,5" />
            <Button Content="Rank down" Click="MoveRank_Click" Tag="1" Margin="0,0,5,5" />
            <Button Content="Tie with rank above" Click="Tie_Click" Margin="0,0,5,5" />
            <Button Content="New rank" Click="Separate_Click" Margin="0,0,5,5" />
            <Button Content="Remove" Click="Remove_Click" Margin="0,0,5,5" />
            <ComboBox x:Name="EntryBrowser" SelectedValuePath="Tag" Width="95" Margin="0,0,5,5"
                      AutomationProperties.Name="Selected channel browser">
                <ComboBoxItem Content="Default" Tag="" />
                <ComboBoxItem Content="Edge" Tag="edge" />
                <ComboBoxItem Content="Chrome" Tag="chrome" />
            </ComboBox>
            <Button Content="Set browser" Click="SetBrowser_Click" Margin="0,0,5,5" />
        </WrapPanel>
        <ListBox x:Name="Ranked" SelectionChanged="Selection_Changed" DisplayMemberPath="Label"
                 AllowDrop="True" PreviewMouseLeftButtonDown="Drag_Start" PreviewMouseMove="Drag_Move"
                 Drop="Rank_Drop" AutomationProperties.Name="Ranked channels" />
    </DockPanel>
</UserControl>
