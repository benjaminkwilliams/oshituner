<UserControl x:Class="oshituner.OshiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ExplainedHeader" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Focusable" Value="True" />
            <EventSetter Event="GotKeyboardFocus" Handler="ExplainedHeader_GotKeyboardFocus" />
            <EventSetter Event="LostKeyboardFocus" Handler="ExplainedHeader_LostKeyboardFocus" />
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="12">
        <TextBlock x:Name="AutomationStatus" DockPanel.Dock="Top" Margin="0,0,0,6" />
        <TextBlock Text="Right-click the channel grid for actions" DockPanel.Dock="Top" Margin="0,0,0,6"
                   Foreground="{DynamicResource MutedForeground}" />
        <DataGrid x:Name="Browsers" DockPanel.Dock="Top" Margin="0,0,0,10"
                  IsReadOnly="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                  CellEditEnding="BrowserCell_EditEnding" AutomationProperties.Name="Oshi browsers">
            <DataGrid.Columns>
                <DataGridTextColumn Header="BROWSER" Binding="{Binding Name}" IsReadOnly="True" Width="95" />
                <DataGridTextColumn Header="TAB LIMIT" Binding="{Binding EditCap, UpdateSourceTrigger=Explicit}" Width="85" />
                <DataGridTextColumn Header="MANAGED" Binding="{Binding Managed}" IsReadOnly="True" Width="85" />
                <DataGridTextColumn Binding="{Binding Status}" IsReadOnly="True" Width="*">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="SCHEDULING STATUS" Style="{StaticResource ExplainedHeader}"
                                   AutomationProperties.Name="Scheduling Status" AutomationProperties.HelpText="Why Oshi Watch is acting or waiting. Managed counts confirmed assignments and Next shows when the next decision is due."
                                   ToolTip="{Binding Path=(AutomationProperties.HelpText), RelativeSource={RelativeSource Self}}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Header="NEXT (MIN)" Binding="{Binding Next}" IsReadOnly="True" Width="100" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="GridFeedback" DockPanel.Dock="Bottom" Foreground="{DynamicResource MutedForeground}" />
        <DataGrid x:Name="Ranked" AlternatingRowBackground="Transparent" IsReadOnly="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                  PreviewMouseRightButtonDown="SelectRowForMenu" CellEditEnding="RankCell_EditEnding"
                  AutomationProperties.Name="Oshi channels">
            <DataGrid.ContextMenu>
                <ContextMenu Opened="RankMenu_Opened" />
            </DataGrid.ContextMenu>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Shaded}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource GridStripeOverlay}" />
                        </DataTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SelectedBackground}" />
                            <Setter Property="Foreground" Value="{DynamicResource SelectedForeground}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="RANK" Binding="{Binding RankNumber}" IsReadOnly="True" Width="62" />
                <DataGridTextColumn x:Name="RankNameColumn" Header="RANK NAME" Binding="{Binding EditRankName, UpdateSourceTrigger=Explicit}" Width="130" />
                <DataGridTextColumn Header="CHANNEL" Binding="{Binding ChannelName}" IsReadOnly="True" Width="150" />
                <DataGridTextColumn Header="PROVIDER" Binding="{Binding Provider}" IsReadOnly="True" Width="90" />
                <DataGridTextColumn Header="BROWSER" Binding="{Binding Browser}" IsReadOnly="True" Width="100" />
                <DataGridTextColumn x:Name="RotationColumn" Binding="{Binding EditRotation, UpdateSourceTrigger=Explicit}" Width="135">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="MIN WATCH (MIN)" ToolTip="Minimum watch time before a newly live channel in the same rank can take the tab. Default is 30 minutes." />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="FallbackColumn" Binding="{Binding EditFallback, UpdateSourceTrigger=Explicit}" Width="125">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="FALLBACK (MIN)" ToolTip="Default is 10 minutes. Set 5 to 60, or leave blank to reset." />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Eligibility}" IsReadOnly="True" Width="*">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="ELIGIBILITY" Style="{StaticResource ExplainedHeader}"
                                   AutomationProperties.Name="Eligibility" AutomationProperties.HelpText="Whether this channel is currently eligible for scheduling. The row may retain a saved rank after its follow or sub ends."
                                   ToolTip="{Binding Path=(AutomationProperties.HelpText), RelativeSource={RelativeSource Self}}" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
