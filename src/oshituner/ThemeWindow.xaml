<Window x:Class="oshituner.ThemeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Theme" Background="{DynamicResource WindowBackground}" FontFamily="{DynamicResource ApplicationFont}" Foreground="{DynamicResource PrimaryForeground}" Width="700" Height="645" MinWidth="555" MinHeight="475" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Apply" Click="Apply_Click" Margin="0,0,6,0" />
            <Button Content="OK" Click="Ok_Click" IsDefault="True" Margin="0,0,6,0" />
            <Button Content="Cancel" Click="Cancel_Click" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <WrapPanel Margin="0,0,0,10">
                    <Label Content="_Mode" Target="{Binding ElementName=Mode}" />
                    <ComboBox x:Name="Mode" Width="110" SelectionChanged="SelectionChanged" Margin="0,0,14,0" />
                    <Label Content="_Font" Target="{Binding ElementName=FontChoice}" />
                    <ComboBox x:Name="FontChoice" Width="230" SelectionChanged="SelectionChanged" />
                </WrapPanel>
                <WrapPanel Margin="0,0,0,10">
                    <Label Content="_Background" Target="{Binding ElementName=BackgroundChoice}" />
                    <ComboBox x:Name="BackgroundChoice" Width="120" SelectionChanged="SelectionChanged" Margin="0,0,14,0" />
                    <Label Content="Image _placement" Target="{Binding ElementName=Placement}" />
                    <ComboBox x:Name="Placement" Width="145" SelectionChanged="SelectionChanged" />
                </WrapPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentControl x:Name="WheelHost" Width="128" Height="128" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1">
                        <Label Content="Colour _brightness" Target="{Binding ElementName=Brightness}" />
                        <Slider x:Name="Brightness" Minimum="0" Maximum="100" Value="100" ValueChanged="Brightness_Changed" />
                        <WrapPanel Margin="0,8,0,6">
                            <Label Content="_R" Target="{Binding ElementName=Red}" />
                            <TextBox x:Name="Red" Width="48" MaxLength="3" TextChanged="RgbChanged" />
                            <Label Content="_G" Target="{Binding ElementName=Green}" />
                            <TextBox x:Name="Green" Width="48" MaxLength="3" TextChanged="RgbChanged" />
                            <Label Content="_B" Target="{Binding ElementName=Blue}" />
                            <TextBox x:Name="Blue" Width="48" MaxLength="3" TextChanged="RgbChanged" Margin="0,0,8,0" />
                            <Border x:Name="Swatch" Width="30" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" />
                        </WrapPanel>
                        <Button Content="Use default colour" HorizontalAlignment="Left" Click="DefaultColour_Click" />
                    </StackPanel>
                </Grid>
                <WrapPanel Margin="0,0,0,6">
                    <Button x:Name="BuiltInButton" Content="Vtuber 4k" Click="BuiltIn_Click" Margin="0,0,6,0" />
                    <Button x:Name="BrowseButton" Content="Browse…" Click="Browse_Click" Margin="0,0,8,0" />
                    <TextBlock x:Name="ImageName" />
                </WrapPanel>
                <DockPanel Margin="0,0,0,8">
                    <Label DockPanel.Dock="Left" Content="Image _URL" Target="{Binding ElementName=ImageUrl}" />
                    <Button x:Name="LoadButton" DockPanel.Dock="Right" Content="Load URL" Click="Load_Click" Margin="6,0,0,0" />
                    <TextBox x:Name="ImageUrl" />
                </DockPanel>
                <CheckBox x:Name="AllowPrivateImageUrl" Content="Allow local network destinations for this image URL" Margin="0,0,0,8" />
                <Label x:Name="OpacityLabel" Target="{Binding ElementName=SurfaceOpacity}" />
                <Slider x:Name="SurfaceOpacity" Minimum="0" Maximum="100" TickFrequency="1"
                        IsSnapToTickEnabled="True" ValueChanged="Opacity_Changed" AutomationProperties.Name="Background opacity" />
                <DockPanel LastChildFill="False" Margin="0,2,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="Transparent" />
                    <TextBlock DockPanel.Dock="Right" Text="Solid" />
                </DockPanel>
                <Grid Height="100" ClipToBounds="True">
                    <ContentControl x:Name="PreviewHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    <Border x:Name="PreviewTint" Padding="12" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                        <TextBlock x:Name="PreviewText" Text="Theme preview" FontSize="18" />
                    </Border>
                </Grid>
                <TextBlock x:Name="Feedback" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
