<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyTitle>Oshi Tuner</AssemblyTitle>
    <Product>Oshi Tuner</Product>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>$(MSBuildProjectDirectory)/../../static/images/vtuber.ico</ApplicationIcon>
    <OshiExtensionIcons>../../static/images/png/vtuber-16x16.png;../../static/images/png/vtuber-32x32.png;../../static/images/png/vtuber-48x48.png;../../static/images/png/vtuber-128x128.png</OshiExtensionIcons>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(OshiTwitchClientId)' != ''">
    <AssemblyMetadata Include="OshiTwitchClientId" Value="$(OshiTwitchClientId)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../browser/edge/manifest.json" Link="browser/edge/manifest.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../browser/chrome/manifest.json" Link="browser/chrome/manifest.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../browser/worker.js" Link="browser/edge/worker.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../browser/worker.js" Link="browser/chrome/worker.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../browser/player-recovery.js" Link="browser/edge/player-recovery.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../browser/player-recovery.js" Link="browser/chrome/player-recovery.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(OshiExtensionIcons)" Link="browser/edge/icons/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(OshiExtensionIcons)" Link="browser/chrome/icons/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="$(ApplicationIcon)" Link="static/images/vtuber.ico" />
    <Resource Include="../../static/images/png/vtuber-32x32.png" Link="static/images/png/vtuber-32x32.png" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <Content Include="../../static/images/vtuber-viewer-background-4k-v2.png" Link="static/images/vtuber-viewer-background-4k-v2.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ThirdParty/SkiaSharp-*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ThirdParty/ModelContextProtocol-*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CheckOshiTunerOutputLock" BeforeTargets="PrepareForBuild"
          Condition="'$(OS)' == 'Windows_NT' and '$(DesignTimeBuild)' != 'true' and Exists('$(TargetDir)$(TargetName).exe')">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../../scripts/Guard-BrowserHost.ps1&quot; -Mode Check -Executable &quot;$(TargetDir)$(TargetName).exe&quot;" />
  </Target>

  <Import Project="Version.props" />
  <Import Project="BuildVersion.targets" />
</Project>
