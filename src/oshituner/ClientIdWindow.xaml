<Window x:Class="oshituner.ClientIdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Twitch Client ID" Width="480" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}" FontFamily="{DynamicResource ApplicationFont}" Foreground="{DynamicResource PrimaryForeground}">
    <StackPanel Margin="24">
        <TextBlock Text="Twitch Client ID" FontSize="22" FontWeight="Bold" />
        <StackPanel x:Name="ChoicePanel" Margin="0,12,0,6">
            <RadioButton x:Name="BuiltInChoice" GroupName="TwitchClientChoice" Content="Use the built-in ID" Margin="0,0,0,6" />
            <RadioButton x:Name="CustomChoice" GroupName="TwitchClientChoice" Content="Use my own ID" />
            <TextBox x:Name="ClientIdTextBox" Margin="0,6,0,0" MaxLength="128" AutomationProperties.Name="Custom Twitch Client ID">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=CustomChoice}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </StackPanel>
        <TextBlock x:Name="EditorMessage" Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Margin="0,0,6,0" Click="Close_Click">Close</Button>
            <Button x:Name="ApplyClientIdButton" IsDefault="True" Click="Apply_Click">Apply</Button>
        </StackPanel>
    </StackPanel>
</Window>
