{
  "manifest_version": 3,
  "name": "Oshi Tuner Browser Integration",
  "version": "1.0.0.10",
  "description": "Manage Twitch stream windows, find gifted subscriptions, and recover from player Error #1000 with Oshi Tuner.",
  "key": "",
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": ["player-recovery.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "nativeMessaging",
    "scripting",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://www.twitch.tv/*"
  ]
}
